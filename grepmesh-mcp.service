[Unit]
Description=GrepMesh MCP local and federated file search
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=grepmesh
Group=grepmesh
EnvironmentFile=/etc/grepmesh-mcp/peer.env
EnvironmentFile=-/etc/grepmesh-mcp/gptadmin.env
ExecStart=/usr/local/bin/grepmesh-mcp --config /etc/grepmesh-mcp/config.json
Restart=on-failure
RestartSec=30s
CPUQuota=200%
MemoryHigh=4G
MemoryMax=6G
MemorySwapMax=1G
TasksMax=384
IOWeight=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/grepmesh-mcp
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
