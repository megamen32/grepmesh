{
  "host_id": "mac-m1",
  "bind": "127.0.0.1:9419",
  "local_bind": null,
  "root": "/Users/user/Documents",
  "roots": {
    "desktop": [
      "/Users/user/Desktop"
    ],
    "downloads": [
      "/Users/user/Downloads"
    ]
  },
  "peers": [],
  "limits": {
    "overall_timeout_ms": 20000,
    "peer_timeout_ms": 25000,
    "full_rebuild_min_interval_ms": 604800000,
    "index_activity": {
      "window_ms": 60000,
      "hot_event_threshold": 500,
      "hot_changed_bytes_threshold": 536870912,
      "hot_debounce_ms": 15000,
      "hot_cooldown_ms": 3600000,
      "metadata_only_globs": [
        "Downloads/**"
      ],
      "exclude_globs": []
    }
  },
  "index_path": "/Users/user/.cache/grepmesh/mac-m1.sqlite3",
  "exclude_globs": [
    "**/.git/**",
    "**/.svn/**",
    "**/.hg/**",
    "**/node_modules/**",
    "**/.pnpm-store/**",
    "**/bower_components/**",
    "**/venv/**",
    "**/.venv/**",
    "**/__pycache__/**",
    "**/.tox/**",
    "**/.nox/**",
    "**/.pytest_cache/**",
    "**/.mypy_cache/**",
    "**/.ruff_cache/**",
    "**/target/**",
    "**/dist/**",
    "**/build/**",
    "**/out/**",
    "**/.next/**",
    "**/.nuxt/**",
    "**/coverage/**",
    "**/.cache/**",
    "**/.Trash/**"
  ],
  "stt": {
    "enabled": true,
    "backend": "remote",
    "model": "whisper-1",
    "model_dir": null,
    "remote_base_url": "https://whisper.bezrabotnyi.com",
    "api_key_env": "GREPMESH_STT_API_KEY",
    "auto_download": false,
    "max_media_bytes": 4294967296
  },
  "ocr": {
    "enabled": true,
    "det_model": "pp-ocrv6_tiny_det.onnx",
    "rec_model": "eslav_pp-ocrv5_mobile_rec.onnx",
    "dict": "ppocrv5_eslav_dict.txt",
    "pdf_fallback": true,
    "min_pdf_text_chars": 64,
    "pdf_dpi": 180,
    "max_pdf_pages": 200,
    "max_image_bytes": 268435456
  },
  "topology_cache_path": "/Users/user/.cache/grepmesh/topology.json",
  "gptadmin_topology_url": "https://u-f1102930.t.gptadmin.bezrabotnyi.com/mcp-relay/grepmesh",
  "gptadmin_token_env": "GPTADMIN_GREPMESH_TOKEN",
  "topology_ttl_ms": 30000
}
